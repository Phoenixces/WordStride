    "react-dom": "19.2.5",
    "@fontsource/space-grotesk": "5.3.0"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "typescript": "5.9.3",
    "vite": "7.2.2",
    "vitest": "4.0.10",
    "@playwright/test": "1.64.1",
    "@types/node": "22.16.4"
  },
  "overrides": {
    "postcss": "8.5.23",
    "rollup": "4.53.3",
    "nanoid": "3.3.18",
    "picomatch": "4.0.3",
    "tinyrainbow": "3.0.3",
    "chai": "6.2.1"
  }
